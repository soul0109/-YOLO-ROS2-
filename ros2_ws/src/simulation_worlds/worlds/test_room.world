<?xml version="1.0" ?>
<!--
  阶段 4.1 / T1.6：test_room v2 — 三机房 + 走廊（几何修复版）

  室内总廓 10.0 × 6.0 m；墙厚 0.1 m；墙高 1.0 m
  走廊：y ∈ [2.25, 3.75]（净宽 1.5 m），西端竖向通道 x ∈ [0.15, 1.65]
  门洞净宽：1.1 m（房 A/B 北墙、房 C 南墙各一）

  ── 设备柜中心（0.8W × 0.4D × 1.2H，贴房间远墙）──
  柜 A（房 A 南墙，3×绿）：  (3.15, 0.35, 0.6)  正面朝 +Y
  柜 B（房 B 南墙，2G+1R）：(8.45, 0.35, 0.6)  正面朝 +Y
  柜 C（房 C 北墙，2G+1Y）：(5.25, 5.65, 0.6)  正面朝 -Y

  ── 航点（地面参考点，yaw 为车头朝向，正对柜面）──
  起点/充电： (0.90, 3.00, 0)  yaw= 0.00 rad (+X，沿走廊向东)
  停车 A：    (3.15, 1.75, 0)  yaw=-1.57 rad (-Y，面向柜 A)
  停车 B：    (8.45, 1.75, 0)  yaw=-1.57 rad (-Y，面向柜 B)
  停车 C：    (5.25, 4.25, 0)  yaw= 1.57 rad (+Y，面向柜 C)

  巡检环：起点 → 房A → 房B → 房C → 返回起点（全程约 20 m）
-->
<sdf version="1.6">
  <world name="test_room">

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.75 0.78 0.82 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0.6 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.1 -1</direction>
    </light>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ═══════════════ 外墙 10 × 6 m ═══════════════ -->
    <model name="wall_south">
      <pose>5.0 0.05 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.0 0.1 1.0</size></box></geometry><laser_retro>80.0</laser_retro></collision>
